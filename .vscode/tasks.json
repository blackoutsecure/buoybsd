{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BuoyBSD: build",
      "type": "shell",
      "command": "cargo",
      "args": ["build", "--locked", "--bin", "buoybsd", "--bin", "buoyctl"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": false,
      "group": {"kind": "build", "isDefault": true},
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": false},
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "BuoyBSD: test",
      "type": "shell",
      "command": "cargo",
      "args": ["test", "--locked", "--all-targets", "--all-features"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": false,
      "group": {"kind": "test", "isDefault": true},
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": false},
      "problemMatcher": ["$rustc"]
    }
  ]
}