{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "BuoyBSD: build",
      "type": "shell",
      "command": "go",
      "args": ["run", "./tools/dev", "build"],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": false,
      "group": {"kind": "build", "isDefault": true},
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": false},
      "problemMatcher": ["$go"]
    },
    {
      "label": "BuoyBSD: test",
      "type": "shell",
      "command": "go",
      "args": ["test", "-timeout", "120s", "./..."],
      "options": {"cwd": "${workspaceFolder}"},
      "isBackground": false,
      "group": {"kind": "test", "isDefault": true},
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": false},
      "problemMatcher": ["$go"]
    }
  ]
}